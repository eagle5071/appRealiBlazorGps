@inherits LayoutComponentBase
@inject AppSettingsService Settings
@inject NavigationManager Nav

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
	protected override void OnInitialized()
	{
		// Se l'utente non è già nella pagina settings e l'app non è configurata
		if (!Settings.IsConfigured && !Nav.Uri.Contains("settings"))
		{
			Nav.NavigateTo("/settings");
		}
	}
}
